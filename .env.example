# Copy to .env (demo/run_all.py creates .env for you the first time). NEVER commit .env.
# Shared secret that the gateway uses to talk to the proxy and the access service (16+ characters).
INTERNAL_SECRET=change-me-to-a-long-random-string

# Optional: change ports if something else on your computer is using them.
# GATEWAY_PORT=8000
# PROXY_PORT=8001
# ACCESS_PORT=8002
# IPFS_API_PORT=5101
# WEB_PORT=3000

# Demo sign-in has no passwords (fine on your own computer, NOT real security). Switch it off with:
# DEMO_LOGIN=off
